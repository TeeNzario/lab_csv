generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ValorantPlayer {
  id             Int     @id @default(autoincrement())
  playerName     String
  riotId         String  @unique
  region         String
  rank           String
  mainAgent      String
  headshotRate   Float
  kdRatio        Float
  matchesPlayed  Int

  @@map("valorant_players")
}

model ValorantPlayerImport {
  id             Int     @id @default(autoincrement())

  playerName     String?
  riotId         String?
  region         String?
  rank           String?
  mainAgent      String?
  headshotRate   Float?
  kdRatio        Float?
  matchesPlayed  Int?

  isValid        Boolean @default(true)
  errorMessage   String?

  createdAt      DateTime @default(now())

  @@map("valorant_player_imports")
}
